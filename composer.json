{
    "name": "geeklab/conf",
    "description": "Immutable configuration system for PHP >= 8.3",
    "type": "library",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Ellis Geeklab",
            "email": "email@example.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "symfony/yaml": "^7.4 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "GeekLab\\Conf\\": "src",
            "Tests\\Unit\\": "tests/Unit"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4",
        "phpstan/phpstan": "^2",
        "phpmd/phpmd": "^3"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --no-progress",
        "phpcs": "phpcs src/ --standard=PSR12 -n",
        "phpmd": "phpmd analyze src --format text"
    }
}
